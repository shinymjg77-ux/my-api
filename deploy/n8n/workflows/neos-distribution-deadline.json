        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          -384,
          -128
        ],
        "id": "65f7ec0f-8fca-4f4a-ac99-617af64ff4b8",
        "name": "Run Distribution Deadline Check",
        "onError": "continueRegularOutput",
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000
      },
      {
        "parameters": {
          "jsCode": "const raw = items[0] ?? {};\nconst payload = raw.json?.response ?? raw.json ?? {};\nconst funds = Array.isArray(payload?.funds) ? payload.funds : [];\nconst outputs = [];\n\nfunction formatKst(value) {\n  const date = value ? new Date(value) : new Date();\n  const formatter = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'Asia/Seoul',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: false,\n  });\n  const parts = Object.fromEntries(formatter.formatToParts(date).map((part) => [part.type, part.value]));\n  return `${parts.year}. ${parts.month}. ${parts.day}. ${parts.hour}:${parts.minute} KST`;\n}\n\nfor (const fund of funds) {\n  if (fund?.alert_due !== true) {\n    continue;\n  }\n  const amount = typeof fund.distribution_amount === 'number'\n    ? `$${fund.distribution_amount.toFixed(4)}`\n    : '미공시';\n  const message = `${fund.symbol} 오늘 밤 미국장 마감 전까지 매수 필요\\n주당 분배금: ${amount}`;\n  outputs.push({\n    json: {\n      symbol: fund.symbol,\n      message,\n      logged_at_kst: formatKst(),\n      event_type: 'distribution_alert_sent',\n      market_date: fund.alert_kst_date ?? fund.deadline_kst_date ?? fund.ex_dividend_date ?? '-',\n      message_preview: message,\n      source_workflow: 'NEOS distribution deadline',\n      workflow_execution_id: '',\n    },\n  });\n}\n\nreturn outputs;"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
